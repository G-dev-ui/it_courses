<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_bg">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image"
        android:layout_width="0dp"
        android:layout_height="320dp"
        android:contentDescription="course image"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_circle_white"
        android:contentDescription="back"
        android:src="@drawable/ic_arrow_back"
        android:tint="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/favorite"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_circle_white"
        android:contentDescription="favorite"
        android:src="@drawable/ic_bookmark_outline_black"
        android:clickable="false"
        android:focusable="false"
        android:tint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/rating_chip"
        android:layout_width="@dimen/chip_rating_width"
        android:layout_height="@dimen/chip_rating_height"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_16"
        android:background="@drawable/bg_overlay_12"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="@id/image"
        app:layout_constraintBottom_toBottomOf="@id/image">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_star"
            android:contentDescription="star" />

        <TextView
            android:id="@+id/rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="4.9"
            android:textColor="@color/c_white"
            android:textAppearance="@style/TextAppearance.ItCourses.CourseMeta" />
    </LinearLayout>

    <TextView
        android:id="@+id/start_date"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/chip_rating_height"
        android:layout_marginBottom="@dimen/space_16"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_overlay_12"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:text="22 мая 2024"
        android:textColor="@color/c_white"
        android:textAppearance="@style/TextAppearance.ItCourses.CourseMeta"
        app:layout_constraintStart_toEndOf="@id/rating_chip"
        app:layout_constraintBottom_toBottomOf="@id/image" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/image"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Название курса"
                android:textAppearance="@style/TextAppearance.ItCourses.TitleLarge"
                android:textColor="@color/c_white" />

            <LinearLayout
                android:id="@+id/author_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/author_avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/label"
                    android:contentDescription="author"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeCircle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Автор"
                        android:textColor="#80F2F2F3"
                        android:textAppearance="@style/TextAppearance.ItCourses.CourseMeta" />

                    <TextView
                        android:id="@+id/author_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Merion Academy"
                        android:textColor="@color/c_white"
                        android:textAppearance="@style/TextAppearance.ItCourses.CourseCardTitle" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/start"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Начать курс"
                android:textAllCaps="false"
                android:textColor="@color/c_white"
                android:textAppearance="@style/TextAppearance.ItCourses.LabelLarge.Medium"
                app:backgroundTint="@color/c_accent"
                app:cornerRadius="100dp"
                app:rippleColor="@color/c_overlay_30" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_platform"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Перейти на платформу"
                android:textAllCaps="false"
                android:textColor="@color/c_white"
                android:textAppearance="@style/TextAppearance.ItCourses.LabelLarge.Medium"
                app:backgroundTint="@color/c_surface"
                app:cornerRadius="100dp"
                app:rippleColor="@color/c_overlay_30" />

            <TextView
                android:id="@+id/about_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="О курсе"
                android:textAppearance="@style/TextAppearance.ItCourses.TitleLarge"
                android:textColor="@color/c_white" />

            <TextView
                android:id="@+id/about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Описание курса"
                android:textColor="@color/c_text_secondary"
                android:textAppearance="@style/TextAppearance.ItCourses.BodyMedium" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

