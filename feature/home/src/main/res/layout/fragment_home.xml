<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_bg"
    android:padding="@dimen/space_16">

    <EditText
        android:id="@+id/search"
        android:layout_width="0dp"
        android:layout_height="@dimen/home_search_height"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_8"
        android:background="@drawable/bg_surface_28"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:hint="Search courses..."
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingHorizontal="@dimen/space_16"
        android:textAppearance="@style/TextAppearance.ItCourses.BodyMedium"
        android:textColor="@color/c_white"
        android:textColorHint="@color/c_text_secondary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/filter" />

    <ImageButton
        android:id="@+id/filter"
        android:layout_width="@dimen/home_filter_size"
        android:layout_height="@dimen/home_filter_size"
        android:background="@drawable/bg_surface_28"
        android:contentDescription="filter"
        android:src="@drawable/ic_filter"
        app:layout_constraintTop_toTopOf="@id/search"
        app:layout_constraintBottom_toBottomOf="@id/search"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/sort"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/search"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/sort_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="По дате добавления"
            android:textColor="@color/c_accent"
            android:textAppearance="@style/TextAppearance.ItCourses.LabelLarge.Medium" />

        <TextView
            android:id="@+id/sort_arrows"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="⇅"
            android:textStyle="bold"
            android:textColor="@color/c_accent"
            android:textSize="16sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_16"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/bottom_nav_overlap_padding"
        app:layout_constraintTop_toBottomOf="@id/sort"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

