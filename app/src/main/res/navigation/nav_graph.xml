<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.itcourses.feature.home.presentation.HomeFragment"
        android:label="@string/nav_home" />

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.itcourses.feature.favorites.presentation.FavoritesFragment"
        android:label="@string/nav_favorites" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.itcourses.feature.profile.presentation.ProfileFragment"
        android:label="@string/nav_profile" />

    <fragment
        android:id="@+id/courseFragment"
        android:name="com.itcourses.feature.course.presentation.CourseFragment"
        android:label="@string/course_title">
        <deepLink
            app:uri="courses://course/{courseId}" />
        <argument
            android:name="courseId"
            app:argType="string" />
    </fragment>

</navigation>

